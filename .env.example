# Copy this file to .env and fill in the values. Never commit .env (D83).
# The backend stops at startup if a required variable is missing.
# Write values without quotes or backslashes: both Docker Compose and Spring Boot read this file.

# Database connection (PostgreSQL)
# e.g. jdbc:postgresql://localhost:5433/resonance_planner
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# JWT signing key: at least 256 random bits (D45)
JWT_SECRET=

# OpenRouter API (D126). The model must be free, with a name ending in :free, e.g. nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Admin account created at startup (D19)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend origin allowed by CORS (D48), e.g. http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Backend base URL used by the frontend, e.g. http://localhost:8080
VITE_API_BASE_URL=
